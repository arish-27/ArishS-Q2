# ==============================================================================
# AI Voice Agent Development & Deployment Platform - Environment Configuration
# ==============================================================================

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Application
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3001
FRONTEND_URL=http://localhost:3001

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=supersecretjwtkeyforvoiceagentplatformdevelopment123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Secret Encryption Key (Fernet key for user API secrets stored in DB)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_SECRET_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtYmFzZTY0LWtleS0xMjM0NTY=

# PostgreSQL Database (with pgvector extension)
POSTGRES_USER=voiceagent
POSTGRES_PASSWORD=voiceagent_secret
POSTGRES_DB=voiceagent_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://voiceagent:voiceagent_secret@postgres:5432/voiceagent_db
# For running backend locally outside docker:
# DATABASE_URL=postgresql+asyncpg://voiceagent:voiceagent_secret@localhost:5432/voiceagent_db

# Redis (Session cache & rate limiting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
# For running backend locally outside docker:
# REDIS_URL=redis://localhost:6379/0

# Default AI Providers (Fallback when user does not provide personal key)
DEFAULT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Default STT & TTS Configuration
DEFAULT_STT_PROVIDER=faster-whisper
WHISPER_MODEL_SIZE=base
DEFAULT_TTS_PROVIDER=edge-tts
DEFAULT_TTS_VOICE=en-US-GuyNeural
ELEVENLABS_API_KEY=

# RAG & Knowledge Base
RAG_EMBEDDING_MODEL=text-embedding-004
RAG_EMBEDDING_DIM=768
UPLOAD_STORAGE_DIR=/app/uploads

# Next.js Frontend Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/voice/stream
